{
  "name": "mextropic-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mextropic AI — data infrastructure for AI-led drug discovery",
  "scripts": {
    "dev": "concurrently -n vite,api -c cyan,magenta \"vite\" \"node --watch server/index.js\"",
